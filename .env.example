# ─────────────────────────────────────────────────────────
# SUPABASE (Database + Auth) — free tier at supabase.com
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for privileged
# operations (e.g. workspace provisioning) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for Drizzle migrations AND the
# app's runtime database client (src/lib/db/index.ts).
#
# PRODUCTION (Vercel): this MUST be the Supabase TRANSACTION POOLER
# string — copy it exactly from
#   Supabase Dashboard → Connect → Transaction Pooler
# (port 6543). Do not hand-write the hostname or credentials. The
# direct connection (port 5432) bypasses PgBouncer and exhausts
# Supabase's connection limit under serverless load (the cause of
# production "CONNECT_TIMEOUT ...pooler.supabase.com:5432" errors).
DATABASE_URL=

# ─────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────
# Base URL of this app, used for OAuth redirect construction.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub OAuth is configured inside the Supabase dashboard
# (Authentication -> Providers -> GitHub), not as separate env
# vars here. Supabase handles the OAuth handshake.

# ─────────────────────────────────────────────────────────
# AI PROVIDERS
# Every key below is OPTIONAL at the infrastructure level.
# The provider abstraction (src/lib/ai) checks at runtime which
# keys are present and marks the rest as "not configured" —
# it never fabricates availability. Add keys as you obtain them.
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenRouter (https://openrouter.ai/keys). NOTE: this was missing from
# this file before — if OPENROUTER_API_KEY is unset in the environment,
# the openrouter provider is simply "not configured" and never tried.
OPENROUTER_API_KEY=

# ─────────────────────────────────────────────────────────
# AI MODEL OVERRIDES (all optional)
# Per-provider default models live in src/lib/ai/models.ts, verified
# against each provider's live model catalog on 2026-09-21. When a
# provider deprecates its default, set the corresponding var here
# (e.g. in Vercel project settings) instead of changing code.
# ─────────────────────────────────────────────────────────
GEMINI_DEFAULT_MODEL=
GROQ_DEFAULT_MODEL=
OPENROUTER_DEFAULT_MODEL=
# Qwen and Moonshot model ids depend on the host/account you use —
# always set them via env rather than assuming a code default:
QWEN_DEFAULT_MODEL=
MOONSHOT_DEFAULT_MODEL=

# ─────────────────────────────────────────────────────────
# BACKGROUND WORKER (Render) — see render.yaml
# ─────────────────────────────────────────────────────────
# The worker needs only DATABASE_URL + the provider keys above.
# All values below are optional tuning with safe defaults.
# WORKER_CONCURRENCY=2
# WORKER_LEASE_SECONDS=300
# WORKER_POLL_MS=2000
# WORKER_HEARTBEAT_MS=15000
# WORKER_SCHEDULER_MS=30000
# WORKER_GRACE_MS=25000
# Comma-separated provider fallback order for worker runs:
# WORKER_PROVIDER_PRIORITY=gemini,openrouter,groq

# ─────────────────────────────────────────────────────────
# PLATFORM CONTROLS
# ─────────────────────────────────────────────────────────
# Comma-separated user ids allowed to toggle the global execution
# pause via /api/system/pause. Unset = nobody (feature disabled).
# GLOBAL_ADMIN_USER_IDS=

# ─────────────────────────────────────────────────────────
# INTEGRATIONS (interfaces only — none are wired yet)
# ─────────────────────────────────────────────────────────
# Nothing below is implemented; keys are documented so operators know
# what will be required. Do NOT set them until the corresponding
# connector ships. See docs/ (Clips Forge boundary, browser service).
# CLIPS_FORGE_API_URL=
# CLIPS_FORGE_API_KEY=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
