# ─────────────────────────────────────────────────────────
# SUPABASE (Database + Auth) — free tier at supabase.com
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for privileged
# operations (e.g. workspace provisioning) that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection string for Drizzle migrations.
# Supabase project settings -> Database -> Connection string (URI, "Session" mode).
DATABASE_URL=

# ─────────────────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────────────────
# Base URL of this app, used for OAuth redirect construction.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub OAuth is configured inside the Supabase dashboard
# (Authentication -> Providers -> GitHub), not as separate env
# vars here. Supabase handles the OAuth handshake.

# ─────────────────────────────────────────────────────────
# AI PROVIDERS
# Every key below is OPTIONAL at the infrastructure level.
# The provider abstraction (src/lib/ai) checks at runtime which
# keys are present and marks the rest as "not configured" —
# it never fabricates availability. Add keys as you obtain them.
# ─────────────────────────────────────────────────────────
GEMINI_API_KEY=
GROQ_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
