{
  "name": "xirel-os",
  "version": "0.1.0",
  "private": true,
  "description": "Xirel OS \u2014 AI Operating System (AI runtime + Business OS suite)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate:pg --config=drizzle.config.ts",
    "db:push": "drizzle-kit push:pg --config=drizzle.config.ts",
    "worker": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx worker/index.ts",
    "test:logic": "tsx scripts/test-pure-logic.ts",
    "test:db": "tsx scripts/test-db.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.4.0",
    "@supabase/supabase-js": "^2.45.0",
    "drizzle-orm": "^0.33.0",
    "lucide-react": "^0.468.0",
    "next": "^14.2.5",
    "postgres": "^3.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.19.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.24.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.5",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.9",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
